APP_NAME="A.S ZINGA"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_TIMEZONE=Africa/Abidjan

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# Production PostgreSQL example:
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=aszinga
# DB_USERNAME=aszinga
# DB_PASSWORD=change-me

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

# Production checklist:
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://aszinga.dgafrique.com
# Generate a unique key on the server with: php artisan key:generate --force
# Never commit the production .env file or real credentials.
